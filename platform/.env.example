# Local development only. Use provider-managed secrets outside development.
DATABASE_URL=postgresql://ocasio:local_dev_only@127.0.0.1:55432/ocasio_dev
API_HOST=127.0.0.1
API_PORT=4100
WEB_ORIGIN=http://127.0.0.1:3000
NODE_ENV=development
SESSION_SECRET=
SESSION_TTL_MINUTES=30
# Run npm run setup:local to create a random local secret without printing it.
# Next.js server-side API address defaults to http://127.0.0.1:4100.
# Set INTERNAL_API_URL in apps/web/.env.local when needed.

# Local email inbox: http://127.0.0.1:8035 (docker compose up -d mailpit)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Ocasio <hello@ocasio.test>"
# Optional Google OAuth web credentials; callback is WEB_ORIGIN/api/v1/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
