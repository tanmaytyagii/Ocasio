{
  "name": "@ocasio/worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch-path=dist --watch-path=../../packages/database/dist --watch-path=../../packages/contracts/dist dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ocasio/database": "0.0.1",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2"
  }
}
