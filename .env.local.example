# Local Supabase development
#
# Copy to `.env` to point the app at the local stack started by
# `npx supabase start`. These are Supabase's published local development keys:
# identical on every machine, reaching only a throwaway container on
# 127.0.0.1. They are not secrets.
#
#   cp .env.local.example .env
#
# To go back to a hosted project, restore your own .env from .env.example.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
