{
  "name": "ocasio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/supabase.generated.ts",
    "db:seed:generate": "tsx scripts/generate-seed.ts > supabase/seed.sql",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.7",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "dotenv": "^18.0.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  },
  "description": "An event vendor marketplace \u2014 discover vendors, request bookings, pay, and review the work. React + Supabase/Postgres with database-enforced authorization.",
  "keywords": [
    "marketplace",
    "supabase",
    "postgres",
    "react",
    "typescript",
    "rls",
    "row-level-security",
    "booking-system",
    "tailwindcss",
    "playwright"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanmaytyagii/Ocasio.git"
  },
  "bugs": {
    "url": "https://github.com/tanmaytyagii/Ocasio/issues"
  },
  "homepage": "https://github.com/tanmaytyagii/Ocasio#readme",
  "engines": {
    "node": ">=18"
  }
}
