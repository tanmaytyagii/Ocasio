# Edge function secrets for LOCAL development only.
#
#   cp supabase/functions/.env.example supabase/functions/.env
#   npx supabase functions serve --env-file supabase/functions/.env
#
# supabase/functions/.env is gitignored. Use Razorpay TEST mode keys here
# (rzp_test_…) — never live keys on a development machine.
#
# Hosted projects do not read this file. Set the same names there with:
#   npx supabase secrets set RAZORPAY_KEY_ID=… RAZORPAY_KEY_SECRET=… RAZORPAY_WEBHOOK_SECRET=…
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# by the runtime; do not set them here.

# Dashboard → Account & Settings → API Keys (Test mode).
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# The secret you typed when creating the Test mode webhook. Razorpay cannot
# reach localhost, so local webhook deliveries need a tunnel (see
# docs/OCASIO_DEPLOYMENT.md §6) — or use the signed-event helpers the test
# suite uses.
RAZORPAY_WEBHOOK_SECRET=replace_me

# Optional, development only: point the functions at a stand-in for
# https://api.razorpay.com/v1. Leave unset everywhere else.
# RAZORPAY_API_BASE=http://host.docker.internal:54399/v1
