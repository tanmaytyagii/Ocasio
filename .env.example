# Ocasio — environment template
#
# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
# Anything prefixed VITE_ is inlined into the client bundle and is PUBLIC.
# Server-only secrets (payment keys, LLM keys) must NOT use the VITE_ prefix
# and must never be read from frontend code.

# Supabase project URL — Project Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — Project Settings > API > Project API keys > anon public
#
# This key is PUBLIC by design; it ships in the client bundle. It is only safe
# when Row Level Security is enabled on every table. Without RLS it grants
# anyone full read/write access to your database.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------------------------------
# Payments (Phase 4)
# ---------------------------------------------------------------------------

# Which payment provider adapter the browser uses. Defaults to "test", the
# deterministic local adapter. It cannot settle a payment — only a signed
# webhook can — so it is safe to leave set during development.
#
# Set to a real provider name once one is registered in
# src/services/payments/provider.ts.
VITE_PAYMENT_PROVIDER=test

# ---------------------------------------------------------------------------
# SERVER-ONLY — never prefix these with VITE_
# ---------------------------------------------------------------------------
#
# Anything prefixed VITE_ is inlined into the client bundle and is PUBLIC.
# The values below must never be. They belong to the webhook edge function and
# are set with `supabase secrets set`, not in this file:
#
#   supabase secrets set PAYMENT_WEBHOOK_SECRET=...
#   supabase secrets set PAYMENT_PROVIDER=razorpay
#
#   PAYMENT_WEBHOOK_SECRET      provider signing secret; the webhook fails
#                               closed without it
#   PAYMENT_PROVIDER            provider name recorded on events
#   SUPABASE_SERVICE_ROLE_KEY   injected by the platform into edge functions.
#                               It bypasses RLS. It must never reach the
#                               browser, this file, or any VITE_ variable.
